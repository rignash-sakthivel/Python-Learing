#How do you display all student records from MySQL
import mysql.connector

con = mysql.connector.connect(
    host="localhost",
    user="root",
    password="your_password",
    database="python_db"
)

cur = con.cursor()

cur.execute("SELECT * FROM students")

records = cur.fetchall()

for row in records:
    print(row)

con.close()


#How do you update student marks using Python
cur = con.cursor()

sql = "UPDATE students SET marks = %s WHERE id = %s"

cur.execute(sql, (95, 1))
con.commit()

print("Student marks updated successfully!")

con.close()

#How do you delete a student record using Python

cur = con.cursor()

sql = "DELETE FROM students WHERE id = %s"

cur.execute(sql, (3,))
con.commit()

print("Student record deleted successfully!")

con.close()



#How do you find students who scored more than 80 marks
cur = con.cursor()

cur.execute("SELECT * FROM students WHERE marks > 80")

records = cur.fetchall()

print("Students scoring above 80 marks:")

for row in records:
    print(row)

con.close()


